    {
      "dot": "cyan",
      "title": "Client & Edge Ingress",
      "items": [
        "Client browser executes Tailwind UI, Web Speech API audio synthesis, and CSV exports",
        "Internet-Facing ALB terminates TLS :443, forwards requests to ECS :8000, and returns rendered advisory"
      ]
    },
    {
      "dot": "emerald",
      "title": "Deterministic Computing",
      "items": [
        "ECS Fargate runs async FastAPI runtime with in-process NOAA Rothfusz engine (services/heat_index.py)",
